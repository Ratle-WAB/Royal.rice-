@app.post("/admin/seller-inject-live/<int:sid>")
@admin_guard
def admin_seller_inject_live(sid):
    con = get_db()
    seller = con.execute("SELECT * FROM sellers WHERE id=?", (sid,)).fetchone()
    if not seller:
        con.close()
        flash(f"Seller #{sid} not found.")
        return redirect(url_for("admin_sellers"))

    con.execute("UPDATE sellers SET status='Approved' WHERE id=?", (sid,))
    seller_items = con.execute("SELECT * FROM seller_products WHERE seller_id=?", (sid,)).fetchall()
    if not seller_items:
        con.commit()
        con.close()
        flash(f"Seller #{sid} ({seller['business_name']}) approved! Note: Seller has not submitted any products yet.")
        return redirect(url_for("admin_sellers"))

    injected_count = 0
    for row in seller_items:
        sync_seller_product_to_live(con, row)
        injected_count += 1

    con.commit()
    con.close()
    flash(f"🚀 {injected_count} product(s) from Seller #{sid} ({seller['business_name']}) injected live to the official website!")
    return redirect(request.referrer or url_for("admin_sellers"))


