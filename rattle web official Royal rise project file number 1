        oid = cur.lastrowid
        con.commit()
        con.close()
        session["cart"] = {}
        session["customer_phone"] = cphone
        my_ids = session.get("my_order_ids", [])
        if oid not in my_ids:
            my_ids.append(oid)
        session["my_order_ids"] = my_ids
        flash(f"✅ Order #{oid} booked successfully! Saved in your My Orders section.")
        return redirect(url_for("cust_my_orders"))

    return render_store("""
