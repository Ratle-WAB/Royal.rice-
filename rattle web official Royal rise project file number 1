                {% else %}
                <p style="color:var(--muted);">No Scanner Image Uploaded yet.</p>
                {% endif %}
                <p style="color:var(--gold);font-size:16px;margin:8px 0;"><b>UPI ID:</b> {{ upi_id }}</p>
                <p style="color:var(--muted);font-size:13px;">Scan this QR code using any UPI app (Google Pay, PhonePe, Paytm, etc.) or pay directly to the UPI ID above.</p>
                <input type="hidden" name="upi_id" value="{{ upi_id }}">

