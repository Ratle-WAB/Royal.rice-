@app.route("/checkout", methods=["GET", "POST"])
def cust_checkout():
    cart = session.get("cart", {})
    if not cart:
        return redirect(url_for("cust_products"))
    con = get_db()
    items = []
    total = 0
    for pid_str, qty in cart.items():
        p = con.execute("SELECT * FROM products WHERE id=?", (int(pid_str),)).fetchone()
        if p:
            line = float(p["price"]) * qty
            total += line
            items.append({"product": p, "qty": qty, "line_total": line})

    payment_settings = dict(con.execute("SELECT key, value FROM settings WHERE key IN ('upi_id', 'scanner_image')").fetchall())
    con.close()

    upi_id = payment_settings.get("upi_id", "r39446772@okicici")
    scanner_image = payment_settings.get("scanner_image", "")

    courier_sources = [
        "India Post Speed Post", "VRL Logistics Express", "DTDC Surface Cargo", "Delhivery Heavy Freight",
        "Blue Dart Air Express", "XpressBees Surface", "Ecom Express B2C", "Shadowfax LastMile",
        "Ekart Logistics Hub", "Gati KWE Cargo", "Professional Couriers", "Safe Express Cargo",
        "Overnite Express", "Trackon Couriers", "First Flight Couriers", "ST Couriers",
        "Amazon Transportation Services", "Rivigo Logistics", "FedEx Express India", "DHL Express Surface"
    ]

    if request.method == "POST":
        cname = request.form.get("customer_name")
        cphone = request.form.get("customer_phone")
        address = request.form.get("address")
        courier_source = request.form.get("courier_source")
        upi_utr = request.form.get("upi_utr", "").strip()

        if not upi_utr:
            flash("UPI Transaction ID / UTR Number is mandatory before approving and placing the order.")
            return redirect(url_for("cust_checkout"))

        payment_mode = "UPI / QR Code"
        payment_status = f"Paid via UPI ({upi_id}) | UTR: {upi_utr}"

        summary = ", ".join([f"{it['product']['name']} (x{it['qty']})" for it in items])
        first_p = items[0]["product"]

        con = get_db()
        cur = con.execute("""
            INSERT INTO orders(customer_name, customer_phone, phone, address, courier_source, items_summary, product_name, product_id, quantity, total, payment_mode, upi_utr, payment_status, order_status, status, created_at)
            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
