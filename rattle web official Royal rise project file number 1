@app.route("/admin/export/<report_type>")
@admin_guard
def export_csv(report_type):
    con = get_db()
    output = io.StringIO()
    writer = csv.writer(output)

    if report_type == "orders":
        rows = con.execute("SELECT * FROM orders ORDER BY id DESC").fetchall()
        filename = "orders_report.csv"
        if rows:
            writer.writerow(rows[0].keys())
            for r in rows:
                writer.writerow(dict(r).values())
    elif report_type == "products":
        rows = con.execute("SELECT * FROM products ORDER BY id DESC").fetchall()
        filename = "products_report.csv"
        if rows:
            writer.writerow(rows[0].keys())
            for r in rows:
                writer.writerow(dict(r).values())
    elif report_type == "support":
        rows = con.execute("SELECT * FROM support_tickets ORDER BY id DESC").fetchall()
        filename = "support_report.csv"
        if rows:
            writer.writerow(rows[0].keys())
            for r in rows:
                writer.writerow(dict(r).values())
    else:
        con.close()
        return "Invalid report type", 404

    con.close()
    output.seek(0)
    return Response(output.getvalue(), mimetype="text/csv", headers={"Content-Disposition": f"attachment;filename={filename}"})


