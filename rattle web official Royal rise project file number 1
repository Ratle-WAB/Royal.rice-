@app.route("/seller/login", methods=["GET", "POST"])
def seller_login():
    if "seller_id" in session:
        return redirect(url_for("seller_dashboard"))
    if request.method == "POST":
        phone = request.form.get("phone", "").strip()
        con = get_db()
        seller = con.execute("SELECT * FROM sellers WHERE phone=?", (phone,)).fetchone()
        con.close()
        if seller:
            session["seller_id"] = seller["id"]
            session["seller_name"] = seller["business_name"] or seller["name"]
            return redirect(url_for("seller_dashboard"))
        flash("Seller not found. Please register first.")
    return render_seller("""
    <div style="max-width:440px;margin:30px auto;" class="card">
        <h2>Seller Login</h2>
        <form method="post">
            <label>Mobile Number</label><input name="phone" required placeholder="Enter mobile number">
            <button class="btn" style="width:100%;">Login</button>
        </form>
        <p style="margin-top:16px;text-align:center;"><a href="{{ url_for('seller_register') }}" style="color:var(--gold);">Register New Seller</a></p>
    </div>
    """)


@app.route("/seller/register", methods=["GET", "POST"])
def seller_register():
    if request.method == "POST":
        name = request.form.get("name")
        bname = request.form.get("business_name")
        phone = request.form.get("phone")
        email = request.form.get("email")
        upi_id = request.form.get("upi_id")

        if not upi_id:
            flash("UPI ID is mandatory for seller registration.")
            return redirect(url_for("seller_register"))

        con = get_db()
        try:
            con.execute(
                "INSERT INTO sellers(name, business_name, phone, email, upi_id, status, created_at) VALUES(?,?,?,?,?,'Pending',?)",
                (name, bname, phone, email, upi_id, datetime.now().isoformat())
            )
            con.commit()
        except Exception:
            con.close()
            flash("Registration failed. Mobile number might already be registered.")
            return redirect(url_for("seller_register"))
        con.close()
        flash("Registration submitted successfully with UPI ID! Approval pending.")
        return redirect(url_for("seller_login"))
    return render_seller("""
    <div style="max-width:480px;margin:30px auto;" class="card">
        <h2>Seller Registration (UPI ID Mandatory)</h2>
        <form method="post">
            <label>Full Name</label><input name="name" required placeholder="Enter your full name">
            <label>Business / Farm Name</label><input name="business_name" required placeholder="Enter business name">
            <label>Mobile Number</label><input name="phone" required placeholder="Enter mobile number">
            <label>Email</label><input name="email" placeholder="Enter email (optional)">
            <label><b>UPI ID (Mandatory)</b></label><input name="upi_id" required placeholder="e.g. yourname@okicici or 9876543210@ybl">
            <button class="btn" style="width:100%;">Register Seller Account</button>
        </form>
    </div>
    """)


