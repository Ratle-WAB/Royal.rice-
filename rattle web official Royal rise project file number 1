def admin_guard(f):
    @wraps(f)
    def decorated(*args, **kwargs):
        if not session.get("admin_unlocked"):
            abort(404)
        return f(*args, **kwargs)
    return decorated


def sync_seller_product_to_live(con, row):
    pid = row["id"]
    con.execute("UPDATE seller_products SET status='Approved' WHERE id=?", (pid,))
    old = con.execute("SELECT id FROM products WHERE seller_product_id=?", (pid,)).fetchone()
    pname = row["product_name"]
    if not old:
        con.execute("""
            INSERT INTO products(
                seller_product_id, seller_id, product_name, name, category, description,
                price, unit, stock, image, origin, farming_method, processing_info,
                storage_details, certification, product_type, organic_tier, courier_1,
                courier_2, delivery_days, visible, status, created_at
            ) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,1,'Active',?)
        """, (
            pid, row["seller_id"], pname, pname, row["category"], row["description"],
            row["price"], row["unit"], row["stock"], row["image"], row["origin"],
            row["farming_method"], row["processing_info"], row["storage_details"],
            row["certification"], row["product_type"], row["organic_tier"],
            row["courier_1"], row["courier_2"], row["delivery_days"], datetime.now().isoformat()
        ))
    else:
        con.execute("""
            UPDATE products SET product_name=?, name=?, category=?, description=?, price=?, unit=?, stock=?, image=?, origin=?, farming_method=?, processing_info=?, storage_details=?, certification=?, product_type=?, organic_tier=?, courier_1=?, courier_2=?, delivery_days=?, visible=1, status='Active'
            WHERE seller_product_id=?
        """, (
            pname, pname, row["category"], row["description"], row["price"], row["unit"],
            row["stock"], row["image"], row["origin"], row["farming_method"], row["processing_info"],
            row["storage_details"], row["certification"], row["product_type"], row["organic_tier"],
            row["courier_1"], row["courier_2"], row["delivery_days"], pid
        ))


