@app.route("/cart", methods=["GET", "POST"])
def cust_cart():
    cart = session.get("cart", {})
    if request.method == "POST":
        pid = request.form.get("pid")
        action = request.form.get("action")
        if pid in cart:
            if action == "inc":
                cart[pid] += 1
            elif action == "dec":
                cart[pid] -= 1
                if cart[pid] <= 0:
                    del cart[pid]
            elif action == "remove":
                del cart[pid]
        session["cart"] = cart
        return redirect(url_for("cust_cart"))
    con = get_db()
    items = []
    subtotal = 0
    for pid_str, qty in cart.items():
        p = con.execute("SELECT * FROM products WHERE id=?", (int(pid_str),)).fetchone()
        if p:
            line = float(p["price"]) * qty
            subtotal += line
            items.append({"product": p, "qty": qty, "line_total": line})
    con.close()
    return render_store("""
