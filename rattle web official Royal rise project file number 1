                    <input type="hidden" name="pid" value="{{ it['product']['id'] }}">
                    <button name="action" value="dec" class="btn" style="padding:4px 10px;background:#181818;">-</button>
                    <b style="margin:0 8px;">{{ it['qty'] }}</b>
                    <button name="action" value="inc" class="btn" style="padding:4px 10px;background:#181818;">+</button>
                </form>
            </td>
            <td><b>₹{{ it['line_total'] }}</b></td>
            <td>
                <form method="post" style="display:inline;">
                    <input type="hidden" name="pid" value="{{ it['product']['id'] }}">
                    <button name="action" value="remove" class="btn" style="padding:4px 10px;background:var(--red);">Remove</button>
                </form>
