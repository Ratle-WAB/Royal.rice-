def get_db():
    con = sqlite3.connect(DB_PATH)
    con.row_factory = sqlite3.Row
    return con


def get_theme():
    con = get_db()
    row = con.execute("SELECT value FROM settings WHERE key='theme_color'").fetchone()
    name_row = con.execute("SELECT value FROM settings WHERE key='theme_name'").fetchone()
    con.close()
    return (row["value"] if row else "#8b0000"), (name_row["value"] if name_row else "Royal Red")


